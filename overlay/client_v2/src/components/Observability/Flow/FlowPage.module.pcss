.containerOverride {
    padding-top: 0;
}

.page {
    display: flex;
    flex-direction: column;
    padding: 0 16px 24px;
    gap: 16px;
}

.header {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.headerLeft {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.titleRow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
}

.title {
    margin: 0;
}

.totalBadge {
    font-size: var(--fs-text-t4);
    font-weight: var(--weight-medium);
    padding: 4px 10px;
    border-radius: 999px;
    background-color: var(--page-background-additional);
    color: var(--default-description-text);
}

.blockedBadge {
    background-color: color-mix(in srgb, var(--obs-blocked) 16%, transparent);
    color: var(--obs-blocked);
}

.toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
}

.segmented {
    display: inline-flex;
    flex-wrap: wrap;
    border: 1px solid var(--default-item-divider);
    border-radius: 8px;
    overflow: hidden;
    background-color: var(--default-cards-background);
}

.segBtn {
    border: 0;
    background: transparent;
    color: var(--default-description-text);
    padding: 6px 10px;
    font-size: var(--fs-text-t4);
    font-weight: var(--weight-medium);
    cursor: pointer;

    @media (hover: hover) {
        &:hover {
            background-color: var(--hovered-page-background);
        }
    }
}

.segLiveBtn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.segActive {
    background-color: var(--default-main-button);
    color: var(--default-primary-button-text);

    @media (hover: hover) {
        &:hover {
            background-color: var(--hovered-main-button);
        }
    }
}

.liveBadge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-text-t4);
    font-weight: var(--weight-medium);
    padding: 4px 10px;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--obs-cached) 16%, transparent);
    color: var(--obs-cached);
}

.liveBadgePaused {
    background-color: var(--page-background-additional);
    color: var(--default-description-text);
}

.liveDot,
.liveBtnDot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
    background-color: var(--obs-cached);
}

.liveBadgePaused .liveDot {
    background-color: var(--default-description-text);
}

.segActive .liveBtnDot {
    background-color: currentColor;
}

.liveDotActive {
    animation: obsLivePulse 1.6s ease-in-out infinite;
}

@keyframes obsLivePulse {
    0%,
    100% {
        opacity: 1;
        transform: scale(1);
    }

    50% {
        opacity: 0.4;
        transform: scale(0.8);
    }
}

@media (prefers-reduced-motion: reduce) {
    .liveDotActive {
        animation: none;
    }
}

.clientForm {
    display: flex;
    align-items: center;
    gap: 8px;
}

.clientInput {
    min-width: 200px;
}

.toggles {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-inline-start: auto;
}

.toggleBtn {
    border: 1px solid var(--default-item-divider);
    border-radius: 8px;
    background-color: var(--default-cards-background);
    color: var(--default-main-text);
    padding: 6px 10px;
    font-size: var(--fs-text-t4);
    font-weight: var(--weight-medium);
    cursor: pointer;

    @media (hover: hover) {
        &:hover {
            background-color: var(--hovered-page-background);
        }
    }
}

.blockedBtnActive {
    border-color: var(--obs-blocked);
    background-color: var(--obs-blocked);
    color: var(--default-primary-button-text);

    @media (hover: hover) {
        &:hover {
            background-color: var(--obs-blocked);
            filter: brightness(0.95);
        }
    }
}

.refreshBtn {
    width: 34px;
    height: 34px;
    min-width: 34px;
    padding: 0;
}

.refreshIcon {
    width: 20px;
    height: 20px;
    color: var(--default-product-icon);
}

.filterBar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 10px;
    background-color: var(--default-cards-background);
    box-shadow: var(--default-cards-box-shadow);
    border: 1px solid var(--default-item-divider);
}

.chipsRow,
.trailRow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
}

.crumbRoot {
    border: 1px solid var(--default-item-divider);
    border-radius: 999px;
    padding: 4px 10px;
    background-color: var(--page-background-additional);
    color: var(--default-main-text);
    font-size: var(--fs-text-t4);
    font-weight: var(--weight-medium);
    cursor: pointer;

    @media (hover: hover) {
        &:hover {
            background-color: var(--hovered-page-background);
        }
    }
}

.crumbSep {
    color: var(--default-description-text);
    font-size: var(--fs-text-t3);
    user-select: none;
}

.crumbJumpBtn {
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;

    @media (hover: hover) {
        &:hover {
            text-decoration: underline;
        }
    }
}

.filterChip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px 4px 10px;
    border-radius: 999px;
    background-color: var(--page-background-additional);
    color: var(--default-main-text);
    font-size: var(--fs-text-t4);
    border: 1px solid var(--default-item-divider);
}

.filterChipBlocked {
    border-color: color-mix(in srgb, var(--obs-blocked) 45%, transparent);
    background-color: color-mix(in srgb, var(--obs-blocked) 12%, transparent);
}

.chipKey {
    color: var(--default-description-text);
}

.chipValue {
    font-weight: var(--weight-semi-bold);
}

.chipClose {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--default-description-text);
    cursor: pointer;

    @media (hover: hover) {
        &:hover {
            background-color: var(--hovered-page-background);
            color: var(--default-main-text);
        }
    }
}

.chipCloseIcon {
    width: 12px;
    height: 12px;
}

.filterActions {
    display: flex;
    align-items: center;
    gap: 8px;
}

.notice {
    padding: 10px 14px;
    border-radius: 8px;
    font-size: var(--fs-text-t4);
    background-color: var(--default-notifications-attention);
    color: var(--default-main-text);
}

.card {
    position: relative;
    background-color: var(--default-cards-background);
    box-shadow: var(--default-cards-box-shadow);
    border-radius: 12px;
    padding: 16px;
}

.loader,
.empty {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 220px;
    color: var(--default-description-text);
    font-size: var(--fs-text-t3);
}

.stageHeaders {
    display: flex;
    justify-content: space-between;
    padding: 0 8px 8px;
    font-size: var(--fs-text-t4);
    font-weight: var(--weight-semi-bold);
    color: var(--default-description-text);
}

.stageHeader {
    text-transform: uppercase;
    letter-spacing: 0.03em;
}

.diagramTopBar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 10px;
}

.zoomHint {
    font-size: var(--fs-text-t4);
    color: var(--default-description-text);
}

.zoomControls {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--default-item-divider);
    border-radius: 8px;
    overflow: hidden;
    background-color: var(--default-cards-background);
    margin-inline-start: auto;
}

.zoomBtn,
.zoomReadout {
    border: 0;
    background: transparent;
    color: var(--default-main-text);
    padding: 4px 10px;
    font-size: var(--fs-text-t4);
    font-weight: var(--weight-medium);
    cursor: pointer;

    &:disabled {
        opacity: 0.45;
        cursor: not-allowed;
    }

    @media (hover: hover) {
        &:hover:not(:disabled) {
            background-color: var(--hovered-page-background);
        }
    }
}

.zoomBtn {
    min-width: 28px;
}

.panModeBtn {
    border-inline-end: 1px solid var(--default-item-divider);
}

.zoomBtnActive {
    background-color: var(--default-main-button);
    color: var(--default-primary-button-text);

    @media (hover: hover) {
        &:hover:not(:disabled) {
            background-color: var(--hovered-main-button);
        }
    }
}

.zoomReadout {
    min-width: 52px;
    border-inline: 1px solid var(--default-item-divider);
    font-variant-numeric: tabular-nums;
}

.stageHeadersZoomed {
    position: relative;
    height: 24px;
    overflow: hidden;
    margin-bottom: 4px;
}

.stageHeaderPinned {
    position: absolute;
    top: 0;
    font-size: var(--fs-text-t4);
    font-weight: var(--weight-semi-bold);
    color: var(--default-description-text);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    white-space: nowrap;
}

.svgContainer {
    position: relative;
    width: 100%;
}

.svgViewport {
    position: relative;
    width: 100%;
    overflow: hidden;
    touch-action: pan-y;
    overscroll-behavior: contain;
    user-select: none;
    -webkit-user-select: none;
    outline: none;
    border-radius: 6px;

    &:focus-visible {
        box-shadow: 0 0 0 2px var(--default-focus-outline);
    }
}

.svgPannable {
    cursor: grab;
    touch-action: none;
}

.svgViewport.svgHandMode,
.svgViewport.svgHandMode * {
    cursor: grab;
    touch-action: none;
}

.svgViewport.svgPanning,
.svgViewport.svgPanning * {
    cursor: grabbing;
    user-select: none;
    -webkit-user-select: none;
}

.panTrackX {
    position: absolute;
    left: 6px;
    right: 16px;
    bottom: 4px;
    height: 10px;
    border-radius: 999px;
    cursor: pointer;
    z-index: 2;
}

.panThumbX {
    position: absolute;
    top: 2px;
    height: 6px;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--default-description-text) 42%, transparent);
    transition: background-color var(--t2);

    &:hover,
    &:active {
        background-color: color-mix(in srgb, var(--default-description-text) 72%, transparent);
    }
}

.panTrackY {
    position: absolute;
    top: 6px;
    right: 4px;
    bottom: 16px;
    width: 10px;
    border-radius: 999px;
    cursor: pointer;
    z-index: 2;
}

.panThumbY {
    position: absolute;
    left: 2px;
    width: 6px;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--default-description-text) 42%, transparent);
    transition: background-color var(--t2);

    &:hover,
    &:active {
        background-color: color-mix(in srgb, var(--default-description-text) 72%, transparent);
    }
}

.svg {
    display: block;
}

.linkPath {
    transition: stroke-opacity var(--t2);
    cursor: pointer;

    &:focus-visible {
        outline: none;
        stroke-opacity: 0.85;
    }
}

.nodeGroup {
    cursor: pointer;
    outline: none;

    &:focus-visible rect {
        stroke: var(--default-focus-outline);
        stroke-width: 2px;
    }
}

.nodeSelected rect {
    stroke: var(--default-main-text);
    stroke-width: 2px;
}

.nodeLabel {
    fill: var(--default-main-text);
    font-size: 12px;
    font-weight: var(--weight-medium);
    pointer-events: none;
}

.tooltip {
    position: absolute;
    z-index: 5;
    pointer-events: none;
    padding: 6px 10px;
    border-radius: 6px;
    background-color: var(--default-popup-background);
    color: var(--default-main-text);
    box-shadow: var(--menu-box-shadow);
    border: 1px solid var(--default-item-divider);
    font-size: var(--fs-text-t4);
    white-space: nowrap;
}

.hintBar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--default-item-divider);
}

.hintText {
    font-size: var(--fs-text-t4);
    color: var(--default-description-text);
}

.hintActions {
    display: flex;
    align-items: center;
    gap: 8px;
}

.inspectorHeader {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
}

.inspectorTitleRow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
}

.inspectorTitle {
    margin: 0;
}

.inspectorBadges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
}

.inspectorControls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
}

.drillSearchInput {
    min-width: 230px;
}

.rulesRow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    padding: 10px 12px;
    border-radius: 8px;
    background-color: var(--page-background-additional);
}

.rulesLabel {
    font-size: var(--fs-text-t4);
    font-weight: var(--weight-semi-bold);
    color: var(--default-description-text);
}

.rulesChips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.ruleChip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px;
    border-radius: 6px;
    border: 1px solid var(--default-item-divider);
    background-color: var(--default-cards-background);
    color: var(--default-main-text);
    cursor: pointer;
    font-size: var(--fs-text-t4);

    @media (hover: hover) {
        &:hover {
            background-color: var(--hovered-page-background);
        }
    }
}

.ruleChipActive {
    border-color: var(--default-main-button);
    background-color: color-mix(in srgb, var(--default-main-button) 14%, transparent);
}

.ruleCode {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 12px;
    word-break: break-all;
}

.ruleCount {
    color: var(--default-description-text);
}

.inspectorTabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    border-bottom: 1px solid var(--default-item-divider);
    margin-bottom: 12px;
    padding-bottom: 8px;
}

.tabBtn {
    border: 1px solid transparent;
    border-radius: 8px;
    background: transparent;
    color: var(--default-description-text);
    padding: 6px 12px;
    font-size: var(--fs-text-t4);
    font-weight: var(--weight-medium);
    cursor: pointer;

    @media (hover: hover) {
        &:hover {
            background-color: var(--hovered-page-background);
            color: var(--default-main-text);
        }
    }
}

.tabActive {
    background-color: var(--default-main-button);
    color: var(--default-primary-button-text);

    @media (hover: hover) {
        &:hover {
            background-color: var(--hovered-main-button);
            color: var(--default-primary-button-text);
        }
    }
}

.tableWrap {
    width: 100%;
    overflow-x: auto;
}

.table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-text-t3);

    & th,
    & td {
        padding: 10px 12px;
        text-align: left;
        border-bottom: 1px solid var(--default-item-divider);
        vertical-align: middle;
    }

    & th {
        color: var(--default-description-text);
        font-weight: var(--weight-semi-bold);
        font-size: var(--fs-text-t4);
    }
}

.clickableRow {
    cursor: pointer;

    @media (hover: hover) {
        &:hover {
            background-color: var(--hovered-page-background);
        }
    }
}

.selectedRow {
    background-color: color-mix(in srgb, var(--default-main-button) 10%, transparent);
}

.numCol {
    text-align: right !important;
    font-variant-numeric: tabular-nums;
}

.failText {
    color: var(--obs-error);
    font-weight: var(--weight-semi-bold);
}

.domainBtn {
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--default-main-text);
    font-weight: var(--weight-semi-bold);
    text-align: left;
    cursor: pointer;

    @media (hover: hover) {
        &:hover {
            text-decoration: underline;
        }
    }
}

.subMeta {
    display: block;
    font-size: var(--fs-text-t4);
    color: var(--default-description-text);
}

.svcPill,
.reasonPill,
.kindBadge,
.statusTag {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: var(--weight-medium);
    background-color: var(--page-background-additional);
    color: var(--default-description-text);
}

.svcPill,
.kindService {
    background-color: color-mix(in srgb, var(--obs-forwarded) 14%, transparent);
    color: var(--obs-forwarded);
}

.statusBlocked {
    background-color: color-mix(in srgb, var(--obs-blocked) 16%, transparent);
    color: var(--obs-blocked);
}

.statusError {
    background-color: color-mix(in srgb, var(--obs-error) 16%, transparent);
    color: var(--obs-error);
}

.svcCell {
    display: flex;
    align-items: center;
    gap: 8px;
}

.memberChips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
}

.memberBtn {
    border: 1px solid var(--default-item-divider);
    border-radius: 6px;
    background-color: var(--default-cards-background);
    color: var(--default-main-text);
    padding: 2px 8px;
    font-size: 12px;
    cursor: pointer;

    @media (hover: hover) {
        &:hover {
            background-color: var(--hovered-page-background);
        }
    }
}

.memberBlocked {
    border-color: color-mix(in srgb, var(--obs-blocked) 45%, transparent);
    color: var(--obs-blocked);
}

.memberMore {
    font-size: 12px;
    color: var(--default-description-text);
}

.actionsCol {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
}

.inlineActionBtn {
    border: 1px solid var(--default-item-divider);
    border-radius: 6px;
    background-color: var(--default-cards-background);
    color: var(--default-description-text);
    padding: 3px 8px;
    font-size: 12px;
    cursor: pointer;
    white-space: nowrap;

    &:disabled {
        opacity: 0.6;
        cursor: wait;
    }

    @media (hover: hover) {
        &:hover:not(:disabled) {
            color: var(--default-main-text);
            background-color: var(--hovered-page-background);
        }
    }
}

.blockActionBtn {
    border-color: color-mix(in srgb, var(--obs-blocked) 45%, transparent);
    color: var(--obs-blocked);
}

.allowActionBtn {
    border-color: color-mix(in srgb, var(--obs-allowed) 45%, transparent);
    color: var(--obs-allowed);
}

.qtypesInline {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 4px;
}

.monoCell {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 12px;
    white-space: nowrap;
}

+// clientGroup resolves the primary tag/group name for the given client IDs, or
+// "untagged" when no persistent client tag exists.
+func (clients *clientsContainer) clientGroup(ids []string) string {
+	clients.lock.Lock()
+	defer clients.lock.Unlock()
+
+	if clients.storage == nil {
+		return "untagged"
+	}
+
+	params := &client.FindParams{}
+	for _, id := range ids {
+		if id == "" {
+			continue
+		}
+		if err := params.Set(id); err != nil {
+			continue
+		}
+		if cli, ok := clients.storage.Find(params); ok && len(cli.Tags) > 0 && cli.Tags[0] != "" {
+			return cli.Tags[0]
+		}
+	}
+
+	return "untagged"
+}
+
+// clientName resolves a friendly display name for a client ID or IP, returning
+// an empty string if none is configured or discovered.
+func (clients *clientsContainer) clientName(id string) string {
+	if id == "" || clients.storage == nil {
+		return ""
+	}
+
+	ip, _ := netip.ParseAddr(id)
+	if cli, ok := clients.storage.FindLoose(ip, id); ok && cli.Name != "" {
+		return cli.Name
+	}
+
+	if ip.IsValid() {
+		if rc := clients.storage.ClientRuntime(ip); rc != nil {
+			_, host := rc.Info()
+			if host != "" {
+				return host
+			}
+		}
+	}
+
+	return ""
+}
+
 // type check
 var _ client.AddressUpdater = (*clientsContainer)(nil)
 

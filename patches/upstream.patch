+func TestServer_UpdateStats_observability(t *testing.T) {
+	ups, err := upstream.AddressToUpstream("1.1.1.1", nil)
+	require.NoError(t, err)
+
+	req := &dns.Msg{
+		Question: []dns.Question{{Name: "example.com."}},
+	}
+
+	testCases := []struct {
+		name         string
+		proto        proxy.Proto
+		upstream     upstream.Upstream
+		reason       filtering.Reason
+		rcode        int
+		hasRes       bool
+		fromUpstream bool
+		err          error
+		wantStatus   string
+		wantRcode    string
+		wantUpstream string
+		wantProto    string
+	}{{
+		name:         "forwarded_servfail",
+		proto:        proxy.ProtoHTTPS,
+		upstream:     ups,
+		reason:       filtering.NotFilteredNotFound,
+		rcode:        dns.RcodeServerFailure,
+		hasRes:       true,
+		fromUpstream: true,
+		wantStatus:   "forwarded",
+		wantRcode:    "SERVFAIL",
+		wantUpstream: ups.Address(),
+		wantProto:    "doh",
+	}, {
+		name:       "blocked_nxdomain",
+		proto:      proxy.ProtoTLS,
+		reason:     filtering.FilteredBlockList,
+		rcode:      dns.RcodeNameError,
+		hasRes:     true,
+		wantStatus: "blocked",
+		wantRcode:  "NXDOMAIN",
+		wantProto:  "dot",
+	}, {
+		name:       "rewritten",
+		proto:      proxy.ProtoQUIC,
+		reason:     filtering.RewrittenRule,
+		rcode:      dns.RcodeSuccess,
+		hasRes:     true,
+		wantStatus: "rewritten",
+		wantRcode:  "NOERROR",
+		wantProto:  "doq",
+	}, {
+		name:       "local",
+		proto:      proxy.ProtoUDP,
+		reason:     filtering.NotFilteredNotFound,
+		rcode:      dns.RcodeSuccess,
+		hasRes:     true,
+		wantStatus: "local",
+		wantRcode:  "NOERROR",
+		wantProto:  "plain",
+	}, {
+		name:         "error_dead_end",
+		proto:        proxy.ProtoDNSCrypt,
+		upstream:     ups,
+		reason:       filtering.NotFilteredNotFound,
+		err:          assert.AnError,
+		wantStatus:   "error",
+		wantRcode:    "",
+		wantUpstream: ups.Address(),
+		wantProto:    "dnscrypt",
+	}}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			st := &testStats{}
+			srv := &Server{
+				baseLogger: testLogger,
+				logger:     testLogger,
+				stats:      st,
+				anonymizer: aghnet.NewIPMut(nil),
+			}
+
+			var res *dns.Msg
+			if tc.hasRes {
+				res = &dns.Msg{MsgHdr: dns.MsgHdr{Rcode: tc.rcode}}
+			}
+
+			dctx := &dnsContext{
+				proxyCtx: &proxy.DNSContext{
+					Proto:    tc.proto,
+					Req:      req,
+					Res:      res,
+					Addr:     testClientAddrPort,
+					Upstream: tc.upstream,
+				},
+				startTime:            time.Now(),
+				result:               &filtering.Result{Reason: tc.reason},
+				responseFromUpstream: tc.fromUpstream,
+				err:                  tc.err,
+			}
+
+			srv.updateStats(dctx, "1.2.3.4", 12*time.Millisecond)
+			require.NotNil(t, st.lastEntry)
+			assert.Equal(t, tc.wantStatus, st.lastEntry.Status)
+			assert.Equal(t, tc.wantRcode, st.lastEntry.Rcode)
+			assert.Equal(t, tc.wantUpstream, st.lastEntry.Upstream)
+			assert.Equal(t, tc.wantProto, st.lastEntry.ClientProto)
+			assert.False(t, st.lastEntry.Timestamp.IsZero())
+		})
+	}
+}

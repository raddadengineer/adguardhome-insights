+
+// DomainServiceInfo describes an AdGuard catalog service and category matching
+// a domain or service ID.
+type DomainServiceInfo struct {
+	ID      string
+	Name    string
+	GroupID string
+}
+
+var (
+	domainServiceOnce   sync.Once
+	domainServiceByHost map[string]DomainServiceInfo
+	domainServiceByID   map[string]DomainServiceInfo
+)
+
+func initDomainServiceIndex() {
+	domainServiceByHost = make(map[string]DomainServiceInfo, len(blockedServices)*4)
+	domainServiceByID = make(map[string]DomainServiceInfo, len(blockedServices))
+
+	for _, svc := range blockedServices {
+		info := DomainServiceInfo{
+			ID:      svc.ID,
+			Name:    svc.Name,
+			GroupID: svc.GroupID,
+		}
+		if info.Name == "" {
+			info.Name = info.ID
+		}
+		domainServiceByID[strings.ToLower(svc.ID)] = info
+
+		for _, raw := range svc.Rules {
+			host := parseServiceRuleHost(raw)
+			if host == "" {
+				continue
+			}
+			if _, exists := domainServiceByHost[host]; !exists {
+				domainServiceByHost[host] = info
+			}
+		}
+	}
+}
+
+func parseServiceRuleHost(raw string) string {
+	rule := strings.TrimSpace(strings.ToLower(raw))
+	if rule == "" || strings.HasPrefix(rule, "!") || strings.HasPrefix(rule, "@@") {
+		return ""
+	}
+	if idx := strings.IndexByte(rule, '$'); idx >= 0 {
+		rule = rule[:idx]
+	}
+	rule = strings.TrimPrefix(rule, "||")
+	rule = strings.TrimPrefix(rule, "|")
+	rule = strings.TrimPrefix(rule, "*.")
+	rule = strings.TrimSuffix(rule, "^")
+	rule = strings.TrimSuffix(rule, ".")
+	if rule == "" || strings.ContainsAny(rule, "*/") || !strings.Contains(rule, ".") {
+		return ""
+	}
+
+	return rule
+}
+
+// LookupServiceByID resolves a service ID from [blockedServices].
+func LookupServiceByID(id string) (DomainServiceInfo, bool) {
+	domainServiceOnce.Do(initDomainServiceIndex)
+	info, ok := domainServiceByID[strings.ToLower(strings.TrimSpace(id))]
+
+	return info, ok
+}
+
+// LookupDomainService resolves an AdGuard catalog service and category for
+// domain by walking parent domain suffixes.
+func LookupDomainService(domain string) (DomainServiceInfo, bool) {
+	domainServiceOnce.Do(initDomainServiceIndex)
+
+	host := strings.ToLower(strings.TrimSuffix(strings.TrimSpace(domain), "."))
+	if host == "" {
+		return DomainServiceInfo{}, false
+	}
+
+	parts := strings.Split(host, ".")
+	for i := range max(0, len(parts)-1) {
+		candidate := strings.Join(parts[i:], ".")
+		if info, ok := domainServiceByHost[candidate]; ok {
+			return info, true
+		}
+	}
+
+	return DomainServiceInfo{}, false
+}
+
+// FilterListName returns a human-readable filter list name for id.
+func (d *DNSFilter) FilterListName(id rulelist.APIID) string {
+	switch id {
+	case rulelist.APIIDCustom:
+		return "Custom filtering rules"
+	case rulelist.APIIDEtcHosts:
+		return "/etc/hosts"
+	case rulelist.APIIDBlockedService:
+		return "Blocked services"
+	case rulelist.APIIDParentalControl:
+		return "Parental control"
+	case rulelist.APIIDSafeBrowsing:
+		return "Safe Browsing"
+	case rulelist.APIIDSafeSearch:
+		return "Safe Search"
+	}
+
+	if d != nil && d.conf.filtersMu != nil {
+		d.conf.filtersMu.RLock()
+		defer d.conf.filtersMu.RUnlock()
+
+		for _, f := range d.conf.Filters {
+			if rulelist.APIID(f.ID) == id && f.Name != "" {
+				return f.Name
+			}
+		}
+		for _, f := range d.conf.WhitelistFilters {
+			if rulelist.APIID(f.ID) == id && f.Name != "" {
+				return f.Name
+			}
+		}
+	}
+
+	return fmt.Sprintf("Filter #%d", id)
+}
